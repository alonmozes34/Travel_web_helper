# Canonical origin used for metadata, canonical URLs, sitemap and share cards.
#
# IGNORED on a host that provides VERCEL_PROJECT_PRODUCTION_URL — the host wins,
# because it cannot be wrong about which domain answers for the deployment, and
# a variable in a settings page can be (and was: it named a domain nobody had
# bought, and every share preview came out blank). Choose the canonical domain
# in the host's own domain settings instead.
#
# This variable is for a deployment on a host that supplies no such value.
# The domain is never hard-coded in the application — see src/lib/site.ts.
NEXT_PUBLIC_SITE_URL=

# --- Plan data ---------------------------------------------------------------
# aloSIM Store API credentials (from aloSIM partnerships). Server-only: never
# NEXT_PUBLIC_. With them set, plans come live from aloSIM.
# ALOSIM_CLIENT_ID=
# ALOSIM_CLIENT_SECRET=
#
# Yesim partner id (from the Yesim affiliate dashboard). Not a secret — it is
# in every Yesim link — but setting it is what turns Yesim on.
# YESIM_PARTNER_ID=
#
# ZenSim affiliate id (their ?via=, from the ZenSim affiliate dashboard). Not a
# secret. Setting it turns ZenSim on: prices are read from their country
# pages every six hours (the owner's exception — they have no price feed).
# ZENSIM_AFFILIATE_ID=
#
# The invented demo catalogue, for development and the browser test suites.
# Ignored when a real provider is configured; never set it in production.
# DEMO_CATALOGUE=true

# Search-engine indexing is opt-in. Never turn it on while the catalogue is the
# demo one — that would put fabricated offers in search results. It is also
# gated on the accessibility statement being complete; a build that asks for
# indexing and is refused says so on stdout.
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- The preview gate (off) -------------------------------------------------
# The catalogue names no real company, so the site is public and needs no
# password. Set BOTH of the following to close /esim/* and /search again —
# both, so a password left behind here cannot quietly shut the site.
#
# PREVIEW_GATE=on
# SITE_PASSWORD=            # never NEXT_PUBLIC_ — that ships it to the browser

# --- Price history (optional) ---------------------------------------------
# "The price dropped" on plan cards comes from our own daily record of each
# provider's prices. It needs a private Vercel Blob store connected to the
# project (Vercel → Storage → Create → Blob → Private → Connect), which sets
# BLOB_READ_WRITE_TOKEN by itself. Without it nothing is recorded and the
# cards say nothing about price changes. Vercel Cron (vercel.json) calls
# /api/cron/price-snapshot once a day; with CRON_SECRET set, only that call
# is accepted.
# BLOB_READ_WRITE_TOKEN=
# CRON_SECRET=

# The contact form (/contact). Without RESEND_API_KEY the page says the form
# is not active yet and shows the site's email address instead; nothing is
# ever reported as sent that was not. A free Resend account registered with
# the site's own address can send to that address without verifying a domain.
# RESEND_API_KEY=
# Where messages go (default: the accessibility statement's contact email).
# CONTACT_TO=
# Sender (default: "Yesh Klita <onboarding@resend.dev>"; once yeshklita.com is
# verified in Resend, e.g. "Yesh Klita <contact@yeshklita.com>").
# CONTACT_FROM=
