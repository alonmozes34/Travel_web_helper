# Canonical origin used for metadata, canonical URLs, sitemap and robots.
# Production: https://yeshklita.co.il
# The domain is never hard-coded in the application — see src/lib/site.ts.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Search-engine indexing is opt-in and stays off while plan data is mock.
# Turning it on with invented prices would put fabricated offers in search
# results. It is also gated on the accessibility statement being complete.
NEXT_PUBLIC_ALLOW_INDEXING=false
