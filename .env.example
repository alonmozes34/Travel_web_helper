# Canonical origin used for metadata, canonical URLs, sitemap and share cards.
#
# OPTIONAL on a host that provides VERCEL_PROJECT_PRODUCTION_URL: without this,
# the app uses the host's own production domain, and picks up a custom domain
# automatically once one is attached. Set it explicitly only to override that
# — e.g. https://yeshklita.co.il on a host that does not supply one.
# The domain is never hard-coded in the application — see src/lib/site.ts.
NEXT_PUBLIC_SITE_URL=

# Search-engine indexing is opt-in and stays off while plan data is mock.
# Turning it on with invented prices would put fabricated offers in search
# results. It is also gated on the accessibility statement being complete —
# a build that asks for indexing and is refused says so on stdout.
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- The preview gate -------------------------------------------------------
# The pages that show invented prices under real companies' names (/esim/* and
# /search) are not publicly readable. The rest of the site is. In production
# the gate is DEFAULT CLOSED: with neither of the following set, those pages
# return 503.
#
# Set this in the deployment. Never NEXT_PUBLIC_ — that would ship it to the
# browser. Visitors enter it at /unlock; curl can send it as HTTP Basic.
SITE_PASSWORD=

# The explicit opt-out, for running the built site locally and for the browser
# test suites. Must be the exact string "true". Do not set this in production
# until the catalogue carries real provider data.
ALLOW_UNPROTECTED_MOCK=false
